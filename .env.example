AGENTMAIL_API_KEY=agentmail-key-here
FIRECRAWL_API_KEY=fc-your-api-key-here
SENTRY_DSN=your-sentry-dsn-here

OPENAI_API_KEY=your-openai-api-key-here
LLM_PROVIDER=openai
# small: high-volume classification (harvest) — keep it cheap
LLM_SMALL_MODEL=gpt-4o-mini
# base: everyday judgement (clustering)
LLM_BASE_MODEL=gpt-5.6-luna
# thinking: the few calls people read (digests); defaults to the base model
LLM_THINKING_MODEL=

AGENTMAIL_INBOX_VISION_WATCH=
HIPEAC_AGENTS_DATA_DIR=
HIPEAC_MCP_URL=https://mcp.hipeac.net
HIPEAC_VISION_BOARD_EMAIL=
HIPEAC_VISION_REPLY_TO=
HIPEAC_VISION_TIPS_MAILBOX=
