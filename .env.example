AGENTMAIL_API_KEY=agentmail-key-here
FIRECRAWL_API_KEY=fc-your-api-key-here
SENTRY_DSN=your-sentry-dsn-here

OPENAI_API_KEY=your-openai-api-key-here

LLM_PROVIDER=openai
# Model tiers, each with a reasoning effort ("" sends none, for models without reasoning).
# small: high-volume classification (harvest) — keep it cheap, reasoning off
LLM_SMALL_MODEL=gpt-6-luna
LLM_SMALL_REASONING=none
# base: everyday judgement (clustering, one call a week)
LLM_BASE_MODEL=gpt-6-sol
LLM_BASE_REASONING=low
# thinking: the few calls people read (digests)
LLM_THINKING_MODEL=gpt-6-sol
LLM_THINKING_REASONING=low

AGENTMAIL_INBOX_VISION_WATCH=
HIPEAC_AGENTS_DATA_DIR=
HIPEAC_MCP_URL=https://mcp.hipeac.net
HIPEAC_VISION_BOARD_EMAIL=
HIPEAC_VISION_REPLY_TO=
HIPEAC_VISION_TIPS_MAILBOX=
